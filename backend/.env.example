# ===== Servidor =====
PORT=4000
NODE_ENV=development

# URL del frontend (para CORS). Debe coincidir con donde corre Next.js
CLIENT_URL=http://localhost:3000

# ===== Base de datos (SQLite: un solo archivo) =====
DATABASE_PATH=./database/cms.db

# ===== Seguridad =====
# Cambia esto por una cadena larga y aleatoria. instalar.bat genera una automáticamente.
JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta
JWT_EXPIRES_IN=8h
