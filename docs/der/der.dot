digraph DER {
graph [rankdir=LR, splines=spline, nodesep=0.5, ranksep=1.4, pad=0.4, bgcolor="white", fontname="Helvetica", label=<<B>CMS Sabor Marino — Diagrama Entidad-Relación (3FN)</B><BR/><FONT POINT-SIZE="11" COLOR="#64748B">Motor: SQLite · PK = llave primaria · FK = llave foránea · UK = valor único · ——|&lt; uno a muchos · o = relación opcional</FONT>>, labelloc=t, fontsize=20];
node [shape=plain, fontname="Helvetica", fontsize=11];
edge [color="#475569", penwidth=1.2, arrowsize=0.9];
subgraph cluster_seg { label=<<B>Seguridad</B>>; fontcolor="#0F4C75"; color="#0F4C75"; style="rounded,dashed"; fontsize=13;
"roles" [label=<<TABLE BORDER="1" COLOR="#0F4C75" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0F4C75"><FONT COLOR="white"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#0F4C75"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name_in">name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="name_out"><FONT COLOR="#0F4C75"><B>UK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description_in">description</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="description_out"> </TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" COLOR="#0F4C75" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0F4C75"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#0F4C75"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name_in">name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="name_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="email_in">email</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="email_out"><FONT COLOR="#0F4C75"><B>UK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash_in">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="password_hash_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="is_active_in">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD PORT="is_active_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="last_login_at_in">last_login_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="last_login_at_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="role_id_in">role_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="role_id_out"><FONT COLOR="#0F4C75"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at_in">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="created_at_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at_in">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="updated_at_out"> </TD></TR></TABLE>>];
}
subgraph cluster_med { label=<<B>Medios</B>>; fontcolor="#5B6B7F"; color="#5B6B7F"; style="rounded,dashed"; fontsize=13;
"media" [label=<<TABLE BORDER="1" COLOR="#5B6B7F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#5B6B7F"><FONT COLOR="white"><B>media</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#5B6B7F"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="original_name_in">original_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="original_name_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="alt_text_in">alt_text</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="alt_text_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="uploaded_by_id_in">uploaded_by_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="uploaded_by_id_out"><FONT COLOR="#5B6B7F"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at_in">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="created_at_out"> </TD></TR></TABLE>>];
