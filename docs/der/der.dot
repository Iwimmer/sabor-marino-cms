"roles":id_out:e -> "users":role_id_in:w [dir=both, arrowtail=tee, arrowhead=crowtee];
"users":id_out:e -> "media":uploaded_by_id_in:w [dir=both, arrowtail=tee, arrowhead=crowodot];
"media":id_out:e -> "media_variants":media_id_in:w [dir=both, arrowtail=tee, arrowhead=crowtee];
"media":id_out:e -> "site_settings":logo_id_in:w [dir=both, arrowtail=tee, arrowhead=crowodot];
"users":id_out:e -> "pages":author_id_in:w [dir=both, arrowtail=tee, arrowhead=crowodot];
"pages":id_out:e -> "page_components":page_id_in:w [dir=both, arrowtail=tee, arrowhead=crowtee];
"menus":id_out:e -> "menu_items":menu_id_in:w [dir=both, arrowtail=tee, arrowhead=crowtee];
"pages":id_out:e -> "menu_items":page_id_in:w [dir=both, arrowtail=tee, arrowhead=crowodot];
"menu_items":id_out:e -> "menu_items":parent_id_out:e [dir=both, arrowtail=tee, arrowhead=crowodot];
"categories":id_out:e -> "dishes":category_id_in:w [dir=both, arrowtail=tee, arrowhead=crowtee];
"media":id_out:e -> "dishes":image_id_in:w [dir=both, arrowtail=tee, arrowhead=crowodot];
}