IGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="email_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="address_in">address</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="address_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="map_embed_url_in">map_embed_url</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="map_embed_url_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="footer_text_in">footer_text</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="footer_text_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at_in">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="updated_at_out"> </TD></TR></TABLE>>];
"social_links" [label=<<TABLE BORDER="1" COLOR="#C0603F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#C0603F"><FONT COLOR="white"><B>social_links</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#C0603F"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="platform_in">platform</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="platform_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="url_in">url</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="url_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="sort_order_in">sort_order</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD PORT="sort_order_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="is_visible_in">is_visible</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD PORT="is_visible_out"> </TD></TR></TABLE>>];
}
subgraph cluster_con { label=<<B>Páginas y bloques</B>>; fontcolor="#3282B8"; color="#3282B8"; style="rounded,dashed"; fontsize=13;
"pages" [label=<<TABLE BORDER="1" COLOR="#3282B8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#3282B8"><FONT COLOR="white"><B>pages</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#3282B8"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="title_in">title</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="title_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="slug_in">slug</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="slug_out"><FONT COLOR="#3282B8"><B>UK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="meta_description_in">meta_description</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="meta_description_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="is_home_in">is_home</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD PORT="is_home_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="is_published_in">is_published</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD PORT="is_published_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="author_id_in">author_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="author_id_out"><FONT COLOR="#3282B8"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at_in">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="created_at_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at_in">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="updated_at_out"> </TD></TR></TABLE>>];
"page_components" [label=<<TABLE BORDER="1" COLOR="#3282B8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#3282B8"><FONT COLOR="white"><B>page_components</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#3282B8"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="page_id_in">page_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="page_id_out"><FONT COLOR="#3282B8"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="type_in">type</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="type_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="sort_order_in">sort_order</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD PORT="sort_order_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="is_visible_in">is_visible</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">INTEGER</FONT></TD><TD PORT="is_visible_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="content_in">content</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT (JSON)</FONT></TD><TD PORT="content_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_at_in">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="created_at_out"> </TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at_in">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">TEXT</FONT></TD><TD PORT="updated_at_out"> </TD></TR></TABLE>>];
